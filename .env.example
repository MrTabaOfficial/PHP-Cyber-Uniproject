APP_NAME="Cyber Uniproject"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite needs no server: the file database/database.sqlite is created by "composer setup".
# For MySQL set DB_CONNECTION=mysql and fill in DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Session data is encrypted at rest. The cookie is HTTPS-only automatically when APP_ENV=production.
SESSION_ENCRYPT=true

# "log" writes verification and password reset emails to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Administrators must enable two-factor authentication before using the admin area.
SECURITY_ADMIN_REQUIRES_2FA=true
# Days a security event is kept before the daily prune removes it.
SECURITY_AUDIT_RETENTION_DAYS=90

VITE_APP_NAME="${APP_NAME}"
